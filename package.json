{
  "name": "autodarts-xconfig",
  "version": "2.3.5",
  "description": "Clean successor architecture for autodarts xConfig userscript modules",
  "type": "module",
  "imports": {
    "#feature-assets": {
      "node": "./src/shared/feature-assets.node.js",
      "default": "./src/shared/feature-assets.browser.js"
    },
    "#xconfig-preview-assets": {
      "node": "./src/shared/xconfig-preview-assets.node.js",
      "default": "./src/shared/xconfig-preview-assets.browser.js"
    },
    "#theme-preset-assets": {
      "node": "./src/shared/theme-preset-assets.node.js",
      "default": "./src/shared/theme-preset-assets.browser.js"
    }
  },
  "scripts": {
    "lint": "eslint eslint.config.js src tests scripts loader",
    "lint:fix": "eslint eslint.config.js src tests scripts loader --fix",
    "build": "npm run build:userscript",
    "build:userscript": "node ./scripts/build-userscript.mjs",
    "check:agents": "node ./scripts/check-agent-instructions.mjs",
    "check:syntax": "node ./scripts/check-syntax.mjs",
    "check:changelog": "node ./scripts/check-changelog-consistency.mjs",
    "sync:xconfig-docs": "node ./scripts/sync-xconfig-docs.mjs",
    "sync:autodarts-docs-fixture": "node ./scripts/sync-autodarts-docs-fixture.mjs",
    "test": "npm run check:syntax && node ./scripts/run-tests.mjs",
    "verify": "npm run lint && npm run build && npm test && npm run check:changelog"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.38.0",
    "globals": "^16.4.0"
  },
  "dependencies": {
    "playwright": "^1.59.1"
  }
}
