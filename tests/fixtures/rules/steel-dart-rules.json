  "conformanceCases": {
    "x01Visits": [
      {
        "id": "miss-then-double-finish",
        "scoreBefore": 40,
        "outMode": "double",
        "throws": ["MISS", "D20"],
        "expected": { "scoreAfter": 0, "isFinish": true, "isBust": false, "stopReason": "finished" }
      },
      {
        "id": "fourth-dart-cannot-finish",
        "scoreBefore": 40,
        "outMode": "double",
        "throws": ["MISS", "MISS", "MISS", "D20"],
        "expected": { "scoreAfter": 40, "isFinish": false, "isBust": false, "stopReason": "visit-dart-limit" }
      },
      {
        "id": "unknown-out-mode-fails-closed",
        "scoreBefore": 20,
        "outMode": "mystery",
        "throws": ["S20"],
        "expected": { "scoreAfter": 20, "isFinish": false, "isBust": false, "stopReason": "unknown-out-mode" }
      }
    ],
    "outModes": [
      { "input": "Double Out", "expected": "double" },
      { "input": "Master Out", "expected": "master" },
      { "input": "Straight Out", "expected": "straight" },
      { "input": "mystery", "expected": "" }
    ],
    "cricketVisits": [
      {
        "id": "cricket-fourth-dart-is-ignored",
        "profile": "autodartsCricket",
        "throws": ["T20", "T19", "T18", "T17"],
        "expectedMarks": { "20": 3, "19": 3, "18": 3, "17": 0 },
        "stopReason": "visit-dart-limit"
      },
      {
        "id": "tactics-fourth-dart-is-ignored",
        "profile": "xconfigTactics",
        "throws": ["T14", "T13", "T12", "T11"],
        "expectedMarks": { "14": 3, "13": 3, "12": 3, "11": 0 },
        "stopReason": "visit-dart-limit"
      }
    ]
  },
  "profiles": {
